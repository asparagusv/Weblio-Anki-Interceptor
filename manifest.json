{
  "manifest_version": 3,
  "name": "Weblio Anki Interceptor",
  "version": "1.0",
  "permissions": [
    "storage",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "https://uwl.weblio.jp/*",
    "https://ejje.weblio.jp/*",
    "https://api.weblio.jp/*",
    "https://translate.googleapis.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background-sw.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content.js", 
        "mark.js",
        "dictionary-popup.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}
